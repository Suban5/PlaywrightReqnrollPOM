{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Test with Allure)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "postDebugTask": "open-allure-report",
      "program": "/usr/local/share/dotnet/dotnet",
      "args": [
        "test",
        "--no-build",
        "${workspaceFolder}/PlaywrightReqnrollFramework/PlaywrightReqnrollFramework.csproj"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
